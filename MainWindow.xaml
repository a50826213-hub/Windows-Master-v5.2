<Window
    x:Class="WindowsMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Master v5.2">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          UseLayoutRounding="True"
          RequestedTheme="Dark"
          Background="{ThemeResource WMWindowBrush}">

        <Grid.RowDefinitions>
            <!-- Slightly taller header: +6 px only -->
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- CLEAN TOP HEADER                                      -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Padding="14,6,14,6"
              ColumnSpacing="12"
              Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <Grid Grid.Column="0"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="34"
                        Height="34"
                        CornerRadius="9"
                        Background="{ThemeResource WMAccentSubtleBrush}"
                        VerticalAlignment="Center">

                    <Image Source="ms-appx:///Assets/logo.png"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="0">

                    <TextBlock Text="Windows Master"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource WMTextBrush}" />

                    <TextBlock Text="v5.2"
                               FontSize="10"
                               Foreground="{ThemeResource WMSecondaryTextBrush}" />
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Border Grid.Column="1"
                    Width="470"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource WMStrokeBrush}"
                    Background="{ThemeResource WMCardAltBrush}">

                <Grid>

                    <TextBox x:Name="GlobalSearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             PlaceholderText="Search settings, tools and commands"
                             Padding="38,3,38,3"
                             VerticalContentAlignment="Center"
                             TextChanged="GlobalSearchBox_TextChanged" />

                    <FontIcon Glyph="&#xE721;"
                              FontSize="15"
                              Foreground="{ThemeResource WMSecondaryTextBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="13,0,0,0"
                              IsHitTestVisible="False" />

                    <Button x:Name="ClearSearchButton"
                            Content="×"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="ClearSearch_Click"
                            ToolTipService.ToolTip="Clear search" />
                </Grid>
            </Border>

            <!-- About -->
            <Button Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="About_Click"
                    ToolTipService.ToolTip="About"
                    AutomationProperties.Name="About">

                <FontIcon Glyph="&#xE946;"
                          FontSize="16" />
            </Button>

            <!-- Status -->
            <TextBlock Grid.Column="3"
                       Text="Ready"
                       FontSize="11"
                       Margin="4,0,2,0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource WMSecondaryTextBrush}" />

            <!-- Theme -->
            <Button Grid.Column="4"
                    Content="Theme"
                    MinWidth="82"
                    VerticalAlignment="Center"
                    Click="Theme_Click" />
        </Grid>

        <!-- ===================================================== -->
        <!-- MAIN NAVIGATION                                       -->
        <!-- ===================================================== -->

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="250"
                        CompactPaneLength="64"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>

                <NavigationViewItem Tag="Home"
                                    Content="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Settings"
                                    Content="Windows Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="ControlPanel"
                                    Content="Control Panel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Repair"
                                    Content="Repair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Maintenance"
                                    Content="Maintenance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Performance"
                                    Content="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="SystemTools"
                                    Content="System Tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Commands"
                                    Content="Command Center">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame">

                <!-- Native Windows-style page navigation.
                     Kept intentionally short/light so navigation stays responsive. -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>

            </Frame>
        </NavigationView>

        <!-- ===================================================== -->
        <!-- FOOTER                                                 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2"
              Padding="16,0"
              Background="Transparent">

            <TextBlock Text="Anas Mohamed | Tech — All Rights Reserved © 2027"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{ThemeResource WMSecondaryTextBrush}" />
        </Grid>

    </Grid>
</Window>
