<Application
    x:Class="WindowsMaster.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>

                <!-- DEFAULT -->
                <ResourceDictionary x:Key="Default">
                    <!-- Subtle Button contrast + pointer states -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C9C9C9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#AFAFAF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9F9F9F" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#141414" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />


                    <SolidColorBrush x:Key="WMWindowBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="WMCardBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="WMCardAltBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="WMStrokeBrush" Color="#CFCFCF" />
                    <SolidColorBrush x:Key="WMTextBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="WMSecondaryTextBrush" Color="#555555" />
                    <SolidColorBrush x:Key="WMAccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="WMAccentSubtleBrush" Color="#E7F2FB" />
                    <SolidColorBrush x:Key="WMWarningBrush" Color="#C42B1C" />

                </ResourceDictionary>

                <!-- LIGHT -->
                <ResourceDictionary x:Key="Light">
                    <!-- Subtle Button contrast + pointer states -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C9C9C9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#AFAFAF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9F9F9F" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#141414" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />


                    <!-- Softer whites + slightly stronger contrast -->
                    <SolidColorBrush x:Key="WMWindowBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="WMCardBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="WMCardAltBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="WMStrokeBrush" Color="#CFCFCF" />
                    <SolidColorBrush x:Key="WMTextBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="WMSecondaryTextBrush" Color="#555555" />
                    <SolidColorBrush x:Key="WMAccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="WMAccentSubtleBrush" Color="#E7F2FB" />
                    <SolidColorBrush x:Key="WMWarningBrush" Color="#C42B1C" />

                </ResourceDictionary>

                <!-- DARK -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Subtle Button contrast + pointer states -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#444444" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#444444" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5B5B5B" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#696969" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />


                    <SolidColorBrush x:Key="WMWindowBrush" Color="#141414" />
                    <SolidColorBrush x:Key="WMCardBrush" Color="#222222" />
                    <SolidColorBrush x:Key="WMCardAltBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="WMStrokeBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="WMTextBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="WMSecondaryTextBrush" Color="#C2C2C2" />
                    <SolidColorBrush x:Key="WMAccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="WMAccentSubtleBrush" Color="#183847" />
                    <SolidColorBrush x:Key="WMWarningBrush" Color="#FF6B5F" />

                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Navigation item style -->
            <Style
                TargetType="NavigationViewItem">

                <Setter
                    Property="HorizontalContentAlignment"
                    Value="Stretch" />

                <Setter
                    Property="Margin"
                    Value="4,2" />

                <Setter
                    Property="CornerRadius"
                    Value="8" />

                <Setter
                    Property="MinHeight"
                    Value="46" />

                <Setter
                    Property="FontSize"
                    Value="16" />

                <Setter
                    Property="Padding"
                    Value="12,0" />

            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>
